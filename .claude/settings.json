{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/check-attribution.sh",
            "timeout": 15,
            "statusMessage": "Checking for AI attribution"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/block-push-main.sh",
            "timeout": 10,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ruff-format.sh",
            "timeout": 60,
            "statusMessage": "ruff format"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh run watch *)",
      "Bash(git fetch *)",
      "Bash(uv python find *)",
      "Bash(uv run mypy)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff format --check .)"
    ]
  }
}
