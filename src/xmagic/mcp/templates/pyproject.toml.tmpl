[project]
name = "{name}"
version = "0.1.0"
description = "MCP server for xMagic custom tools"
requires-python = ">=3.11"
dependencies = [
    "mcp>=1.0",
    "starlette>=0.37",
    "uvicorn>=0.29",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{module}"]
